# ==============================================================================
# LeRobot Dataset Visualizer & Annotation Backend Environment
# ==============================================================================

# Dataset host URL (defaults to https://huggingface.co/datasets)
# DATASET_URL=https://huggingface.co/datasets

# Annotation backend service URL (read by Next.js frontend)
# When set, the Annotations tab persists edits and enables Hub commits.
NEXT_PUBLIC_ANNOTATE_BACKEND_URL=http://127.0.0.1:7861

# Hugging Face Access Token & User (read by Python backend for Hub pushes)
# (Copy this file to .env or .env.local to keep your token secret and git-ignored)
# HF_TOKEN="hf_..."
# HF_USER=""

# Backend storage paths (optional overrides)
# LEROBOT_ANNOTATE_CACHE=/tmp/lerobot_visualizer_annotate_cache
# LEROBOT_ANNOTATE_EXPORT=/tmp/lerobot_visualizer_annotate_exports
